# Everything prefixed with VITE_ is bundled into the browser build — it is public.
# Never put secrets here (API keys, JWT secrets, database URLs belong in server/.env).

# Base URL of the API.
#   Leave empty to use "/api" — works with the Vite dev proxy locally and with the
#   Vercel rewrite in client/vercel.json in production (recommended: same-origin cookies).
#   Set to an absolute URL only when calling the API cross-origin, e.g.
#   https://autocare360-api.onrender.com/api
VITE_API_URL=

# Origin that serves locally stored uploads (/uploads/...). Only needed when
# VITE_API_URL is absolute AND the API stores files on disk instead of Cloudinary.
#   e.g. https://autocare360-api.onrender.com
VITE_API_ORIGIN=

# Development only: where the Vite dev server proxies /api and /uploads.
VITE_DEV_API_TARGET=http://localhost:5000
