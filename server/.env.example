# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Public URL of this API (used in links)
SERVER_URL=http://localhost:5000
# Comma-separated list of allowed frontend origins (first one is used in emails)
CLIENT_URL=http://localhost:5173
# Timezone used for monthly reports
APP_TIMEZONE=Asia/Kolkata

# ─── Database ────────────────────────────────────────────────────────────────
# Local:  mongodb://127.0.0.1:27017/autocare360
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/autocare360?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/autocare360

# ─── Authentication ──────────────────────────────────────────────────────────
# Generate strong secrets:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7
# Cross-site deployments (Vercel frontend + Render API) need SameSite=None + Secure cookies.
# Leave empty to use sensible defaults (lax/insecure in development, none/secure in production).
COOKIE_SAME_SITE=
COOKIE_SECURE=
# Number of reverse proxies in front of the API (Render/Railway: 1)
TRUST_PROXY=

# ─── File storage (optional — falls back to local disk when empty) ───────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email (optional — emails are logged to the console when SMTP_HOST is empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="AutoCare360 <no-reply@autocare360.app>"

# ─── Seed (optional) ─────────────────────────────────────────────────────────
# Admin account created by `npm run seed`. Set your own before seeding a shared or
# deployed database; the defaults are for local development only.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ─── Background jobs ─────────────────────────────────────────────────────────
# Set to false to disable the 30-minute maintenance/reminder sweep
ENABLE_JOBS=true
